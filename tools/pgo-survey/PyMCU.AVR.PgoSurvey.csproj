<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pymcuc-avr-pgo-survey</AssemblyName>
    <RootNamespace>PyMCU.AVR.PgoSurvey</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <!-- Same Avr8Sharp family as src/csharp/profiler/, but on the versions that
       actually carry the profiling surface: the profiler pins
       Avr8Sharp.TestKit 1.1.0-beta1, which predates ProfilingDecoder and
       RunCyclesProfiled and does not compile it. TestKit.Core 1.1.0-beta8 is
       the first split package with the profiled run loop; Avr8Sharp
       1.1.0-beta9 is the newest core it can sit on. -->
  <ItemGroup>
    <PackageReference Include="Avr8Sharp" Version="1.1.0-beta9" />
    <PackageReference Include="Avr8Sharp.TestKit.Core" Version="1.1.0-beta8" />
  </ItemGroup>
</Project>
