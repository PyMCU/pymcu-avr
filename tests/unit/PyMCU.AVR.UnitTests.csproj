<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- pymcu monorepo checkout: pymcu and pymcu-avr are siblings under the same
         parent by default. PyMCURepoDir may be overridden from the environment so a
         worktree's tests build the worktree's compiler, not the main checkout's. -->
    <!-- PyMCU, not pymcu: the directory on disk is PyMCU, and MSBuild does NOT resolve a
         reference at the wrong case. Measured on a case-sensitive APFS volume, with a
         control run at the correct spelling on the same volume:
             ..\pymcu\... -> MSB9008 "does not exist", and the build reports 0 Errors
             ..\PyMCU\... -> resolves
         The wrong case does not fail the build, it DROPS the reference and goes green,
         so a case-sensitive CI passes on an artifact missing a dependency. -->
    <PyMCURepoDir Condition="'$(PyMCURepoDir)' == ''">..\..\..\PyMCU</PyMCURepoDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- pymcu-avr backend library -->
    <ProjectReference Include="..\..\src\csharp\lib\PyMCU.Backend.AVR.csproj" />
    <!-- pymcu monorepo compiler (IR types + common models). -->
    <ProjectReference Include="$(PyMCURepoDir)\src\compiler\PyMCU.csproj" />
  </ItemGroup>

</Project>
