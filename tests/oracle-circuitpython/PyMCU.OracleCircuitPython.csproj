<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- FAT12 boot.py injection writes through a pinned flash pointer. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <RootNamespace>PyMCU.OracleCircuitPython</RootNamespace>
        <AssemblyName>PyMCU.OracleCircuitPython</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- Shared I2C-oracle machinery (transaction stream, TWI recorder,
             comparer, oracle.py runner) shared with tests/integration. -->
        <ProjectReference Include="../testkit/PyMCU.TestKit.csproj" />

        <!-- Sibling-repo references: the RP2040Sharp checkout must sit next to
             this repository (see README). Same convention pymcu-arm uses for
             RP2350Sharp. Deliberately NOT the RP2040Sharp test assemblies:
             referencing those would drag their suite and its packages in. -->
        <ProjectReference Include="../../../RP2040Sharp/src/RP2040Sharp/RP2040Sharp.csproj" />
        <ProjectReference Include="../../../RP2040Sharp/src/RP2040.TestKit/RP2040.TestKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="FluentAssertions" Version="6.12.0" />
    </ItemGroup>

</Project>
